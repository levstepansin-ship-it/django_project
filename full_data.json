es.contenttype", "pk": 12, "fields": {"app_label": "recipes", "model": "userpreferences"}}, {"model": "sessions.session", "pk": "d1r336tvm2whh3y80p8zb3msp77bvbbt", "fields": {"session_data": ".eJxVjDsOwyAQBe9CHSGw-aZM7zOghV2CkwgkY1dR7h5bcpG0b2bemwXY1hK2TkuYkV2ZZJffLUJ6Uj0APqDeG0-trssc-aHwk3Y-NaTX7XT_Dgr0stcueQXoVQYro3fWCZWjTkhaDIK8NiDJUMboBmPBWDXqZLPAFEfEHbDPF_D4OKk:1wQltI:s9LGedWortQQG8rk7M1xsrRCIm4cuhOs93x2LJ0BTgs", "expire_date": "2026-06-06T12:55:44.567Z"}}, {"model": "sessions.session", "pk": "wt5yn99t61o3e1n9kmpchap10vqqd388", "fields": {"session_data": ".eJxVjEEOwiAQRe_C2hAGWgGX7j0DYWZAqgaS0q6Md7dNutDte-__twhxXUpYe5rDxOIitDj9Moz0THUX_Ij13iS1uswTyj2Rh-3y1ji9rkf7d1BiL9vaUxoUAZjBO0hKA8Rs0WmP1jqFTm0gkvPGjjhmY4nzGYi9RgadOYvPF8gWN8w:1wZStF:u_rDr1sktBKsIvOKhPetw-1U1CE9zY_h4h9talq_HGY", "expire_date": "2026-06-30T12:27:37.271Z"}}, {"model": "recipes.category", "pk": 1, "fields": {"name": "Пельмени", "slug": "111"}}, {"model": "recipes.category", "pk": 2, "fields": {"name": "Пельмени", "slug": "pelmeni"}}, {"model": "recipes.category", "pk": 3, "fields": {"name": "Вареники", "slug": "vareniki"}}, {"model": "recipes.category", "pk": 4, "fields": {"name": "Каши", "slug": "kashi"}}, {"model": "recipes.subcategory", "pk": 1, "fields": {"category": 1, "name": "Классические", "slug": "pelmeni"}}, {"model": "recipes.subcategory", "pk": 2, "fields": {"category": 1, "name": "Классические", "slug": "pelmeni"}}, {"model": "recipes.subcategory", "pk": 3, "fields": {"category": 1, "name": "Телятина", "slug": "veal"}}, {"model": "recipes.subcategory", "pk": 4, "fields": {"category": 1, "name": "Свинина", "slug": "pork"}}, {"model": "recipes.subcategory", "pk": 5, "fields": {"category": 1, "name": "Говяжьи", "slug": "govyazhi"}}, {"model": "recipes.subcategory", "pk": 6, "fields": {"category": 3, "name": "с творогом", "slug": "vareniki"}}, {"model": "recipes.subcategory", "pk": 7, "fields": {"category": 3, "name": "С картошкой", "slug": "potato"}}, {"model": "recipes.subcategory", "pk": 8, "fields": {"category": 3, "name": "С вишней", "slug": "varenikiwithwish"}}, {"model": "recipes.subcategory", "pk": 9, "fields": {"category": 4, "name": "Каша гречневая в пакетиках", "slug": "pak"}}, {"model": "recipes.recipe", "pk": 1, "fields": {"subcategory": 1, "title": "Как сварить классические пельмени?", "steps": [{"text": "Выбор кастрюли и кипячение воды", "duration": 12, "desc": "Возьми широкую кастрюлю объёмом не менее 4 литров — пельменям нужно пространство, чтобы они не слипались. Налей 2–2,5 литра холодной воды. Соотношение воды и пельменей должно быть примерно 3:1 (на 500 г пельменей — 1,5 литра воды). Добавь 1 столовую ложку соли (без горки) на литр воды — соль укрепляет тесто и придаёт вкус. По желанию: лавровый лист, 3–4 горошины чёрного перца, 1 ст. ложку растительного масла (против слипания). Поставь на сильный огонь и накрой крышкой — так вода закипит быстрее."}, {"text": "Закладка пельменей и ожидание всплытия", "duration": 5, "desc": "Достань пельмени из морозилки прямо перед варкой — НЕ РАЗМОРАЖИВАЙ! Размороженные пельмени размякнут и развалятся. Закрути ложкой воронку в кипящей воде — это поможет пельменям не прилипнуть ко дну. Опускай пельмени по одному или небольшими партиями, чтобы температура воды не падала резко. Сразу после закладки аккуратно перемешай шумовкой (один раз!). Добавь 1 столовую ложку растительного масла — масляная плёнка предотвратит слипание. Жди, пока все пельмени всплывут на поверхность (обычно 3–5 минут). Если через 6 минут не всплыли — огонь слишком слабый, увеличь."}, {"text": "Финишная варка (самое важное)", "duration": 4, "desc": "Как только все пельмени всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Сильное бурление разрывает тесто. Крышкой НЕ НАКРЫВАЙ — иначе температура поднимется, и пельмени разварятся. Вари ровно 4 минуты. Время отсчитывается с момента, когда вода снова закипела после закладки. Для проверки готовности достань один пельмень и разрежь: фарш должен быть серо-коричневым, без розовых пятен, тесто — мягким и упругим. Готовые пельмени вылови шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла — оно не даст слипнуться и придаст нежность. Подавай со сметаной, уксусом, соевым соусом или горчицей."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 2, "fields": {"subcategory": 3, "title": "Пельмени из телятины", "steps": [{"text": "Подготовка воды для телятины", "duration": 12, "desc": "Телятина — очень нежное мясо, поэтому важно не переварить. Выбери широкую кастрюлю (от 3 литров). Налей 2–2,5 литра воды. Добавь 1,5 столовой ложки соли (без горки). Для аромата: лавровый лист, 3–4 горошины чёрного перца, луковицу и морковь целиком — это обогатит бульон. Влей 1 столовую ложку растительного масла — против слипания. Доведи до сильного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка пельменей и ожидание всплытия", "duration": 5, "desc": "Пельмени из телятины бросай только в кипящую воду, не размораживай. Делай воронку ложкой и опускай по одному. Сразу аккуратно перемешай один раз. Жди, пока все пельмени всплывут на поверхность (обычно 3–5 минут). Если пельмени крупные — жди дольше. Добавь ложку растительного масла, чтобы не слипались."}, {"text": "Варка телятины (главное — не переварить)", "duration": 3, "desc": "Как только все пельмени всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Телятина варится 3–4 минуты, не больше! Переваренное мясо станет сухим и жёстким. Крышкой не накрывай. Проверь готовность через 3 минуты: разрежь один пельмень — сок должен быть прозрачным, мясо — нежно-розовым или серым. Если сок розовый — добавь ещё 1 минуту. Готовые пельмени доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла — оно не даст слипнуться и подчеркнёт нежный вкус телятины. Подавай с белым соусом, сметаной или растопленным маслом с зеленью."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 3, "fields": {"subcategory": 4, "title": "Пельмени из свинины", "steps": [{"text": "Кипячение воды для свинины", "duration": 12, "desc": "Свинина жирная, но при переваривании становится сухой. Налей 3 литра воды на 500 г пельменей. Добавь 1 столовую ложку соли с горкой, 1 столовую ложку растительного масла (обязательно!), лавровый лист, 3–4 горошины душистого перца. Доведи до бурного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка пельменей и ожидание всплытия", "duration": 5, "desc": "Пельмени не размораживай! Кидай в кипяток по одному, создавая воронку. Если пельмени мелкие — можно кидать по 2–3 штуки. Перемешай один раз. Жди, пока все пельмени всплывут на поверхность (обычно 3–5 минут). Добавь ещё ложку растительного масла, если боишься слипания."}, {"text": "Варка свинины", "duration": 5, "desc": "Как только все пельмени всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Вари 5 минут. Свинина требует хорошего прогрева, но переваривать нельзя — фарш станет резиновым. Крышкой не накрывай! Готовность проверь разрезом: мясо должно быть полностью проваренным, без розового оттенка. Доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла — оно не даст слипнуться и придаст нежность. Подавай с горчицей, хреном, томатным соусом или сметаной."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 4, "fields": {"subcategory": 5, "title": "Пельмени из говядины", "steps": [{"text": "Кипячение воды для говядины", "duration": 12, "desc": "Говядина — самое плотное мясо, требует больше времени. Налей 2,5–3 литра воды. Добавь 1,5 столовой ложки соли, лавровый лист, 3–4 горошины чёрного перца, 1 столовую ложку растительного масла. Доведи до сильного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка пельменей и ожидание всплытия", "duration": 5, "desc": "Кидай пельмени в кипяток по одному, создавая воронку. Перемешай один раз. Жди, пока все пельмени всплывут на поверхность (обычно 3–5 минут). Если пельмени крупные — жди 4–5 минут. Добавь ложку растительного масла, чтобы не слипались."}, {"text": "Варка говядины", "duration": 5, "desc": "Как только все пельмени всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Вари 5 минут. Говядина должна быть полностью проваренной, иначе мясо будет жёстким. Проверь готовность: разрежь один пельмень — фарш должен быть серо-коричневым, без розовых прожилок. Крышкой не накрывай! Доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла — оно не даст слипнуться и придаст нежность. Подавай с красным соусом, сметаной, кетчупом или горчицей."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 5, "fields": {"subcategory": 6, "title": "Как сварить вареники с творогом?", "steps": [{"text": "Кипячение воды для творожных вареников", "duration": 12, "desc": "Вареники с творогом варятся быстрее, потому что начинка уже готова. Налей 3 литра воды. Добавь 1 столовую ложку соли — даже для сладких вареников, соль укрепляет тесто и усиливает вкус. Можно добавить 1 столовую ложку растительного масла. Доведи до сильного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка вареников и ожидание всплытия", "duration": 4, "desc": "Достань вареники из морозилки прямо перед варкой — не размораживай! Кидай по 2–3 штуки в кипящую воду, создавая воронку. Аккуратно перемешай один раз. Жди, пока все вареники всплывут на поверхность (обычно 3–4 минуты). Если вареники крупные или тесто толстое — жди 4–5 минут. Добавь ложку растительного масла, чтобы не слипались."}, {"text": "Варка творожных вареников", "duration": 2, "desc": "Как только все вареники всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Крышкой не накрывай — иначе тесто разорвётся и начинка вытечет. Вари ровно 2 минуты. Творог внутри уже готов, главное — не переварить тесто. Готовность проверь: вареник должен быть мягким, тесто — не сырым. Доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла — не слипнутся и станут нежнее. Подавай со сметаной, мёдом, вареньем или ягодным соусом."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 6, "fields": {"subcategory": 7, "title": "Как сварить вареники с картошкой?", "steps": [{"text": "Кипячение воды для картофельных вареников", "duration": 12, "desc": "Картофельная начинка уже готова, но требует аккуратного обращения. Налей 2,5–3 литра воды. Добавь 1 столовую ложку соли, 1 столовую ложку растительного масла — это предотвратит слипание. Доведи до сильного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка вареников и ожидание всплытия", "duration": 4, "desc": "Вареники не размораживай! Кидай по 2–3 штуки в кипящую воду, создавая воронку. Аккуратно перемешай один раз. Жди, пока все вареники всплывут на поверхность (обычно 3–4 минуты). Картофельные вареники более нежные, поэтому не перегружай кастрюлю. Добавь ложку растительного масла, чтобы не слипались."}, {"text": "Варка картофельных вареников", "duration": 2, "desc": "Как только все вареники всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Вари 2 минуты. Картошка внутри уже готова, нужно только прогреть тесто. Крышкой не накрывай. Доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла или жареный лук с салом — это классика. Подавай со сметаной, жареным луком или шкварками."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 7, "fields": {"subcategory": 8, "title": "Как сварить вареники с вишней?", "steps": [{"text": "Кипячение воды для вишнёвых вареников", "duration": 12, "desc": "Вишня даёт сок, поэтому тесто должно быть прочным. Налей 3 литра воды. Добавь 1 столовую ложку соли — соль укрепляет тесто и не даёт ему развалиться, когда начнёт вытекать сок. Можно добавить 1 столовую ложку растительного масла. Доведи до сильного кипения на максимальном огне, накрой крышкой."}, {"text": "Закладка вареников и ожидание всплытия", "duration": 4, "desc": "Вареники не размораживай! Кидай по 2 штуки в кипящую воду — не больше! Вишня быстро отдаёт сок, и вода может стать сладкой и пенящейся. Аккуратно перемешай один раз. Жди, пока все вареники всплывут на поверхность (обычно 3–4 минуты). Добавь ложку растительного масла, чтобы не слипались."}, {"text": "Варка вишнёвых вареников", "duration": 2, "desc": "Как только все вареники всплыли, УБАВЬ ОГОНЬ ДО СРЕДНЕГО. Вари ровно 2 минуты, не больше! Вишня прогревается очень быстро. Если переварить — сок вытечет, вареники станут пустыми и безвкусными. Крышкой не накрывай! Доставай шумовкой, дай воде стечь. Сразу добавь кусочек сливочного масла. Подавай со сметаной, йогуртом, мёдом или вишнёвым сиропом."}], "final_message": "Приятного аппетита!"}}, {"model": "recipes.recipe", "pk": 8, "fields": {"subcategory": 9, "title": "Гречневая каша в пакетиках", "steps": [{"text": "Кипятим воду — основа основ", "desc": "Налей в кастрюлю 1,5 литра холодной воды. Добавь 1,5 столовой ложки соли без горки. Соль нужна обязательно — она проникает в крупу через пакетик и делает кашу вкусной. Поставь на сильный огонь. Крышкой не накрывай, чтобы вода не закипела слишком быстро и не убежала. Дождись активного бурления по всей поверхности.", "duration": 10}, {"text": "Закладываем гречку — главный момент", "desc": "Как только вода закипела, опусти пакетик гречки в кастрюлю. Сразу убавь огонь до среднего — вода должна слегка кипеть, а не бушевать. Не накрывай крышкой, иначе температура поднимется и крупа сварится неравномерно. Пакетик должен свободно плавать, не касаясь дна. Вари ровно 23 минуты 25 секунд — это время, за которое гречка становится идеальной: не разваривается в кашу и не остаётся твёрдой.", "duration": 24}, {"text": "Достаём и подаём с душой", "desc": "Выключи огонь. Достань пакетик вилкой за специальный клапан. Дай воде полностью стечь — минуту-две. Разрежь пакетик ножницами, аккуратно высыпь кашу в тарелку. Добавь сливочное масло — не жалей, оно делает гречку нежной и раскрывает её вкус. Подавай горячей, пока она не остыла. Гречка хороша и как гарнир, и как самостоятельное блюдо.", "duration": 0}], "final_message": "Приятного аппетита! Гречка, сваренная по таймеру, получается всегда идеальной — не разваривается и не остаётся сырой. Добавь масло, зелень или грибную подливу — и это уже не гарнир, а полноценное блюдо."}}, {"model": "recipes.comment", "pk": 1, "fields": {"recipe": 3, "author": "Вова", "text": "Клево", "created_at": "2026-06-12T07:14:58.437Z", "is_approved": true}}, {"model": "recipes.comment", "pk": 2, "fields": {"recipe": 3, "author": "Аноним", "text": "т", "created_at": "2026-06-15T10:10:12.188Z", "is_approved": true}}, {"model": "recipes.comment", "pk": 3, "fields": {"recipe": 8, "author": "п", "text": "р", "created_at": "2026-06-16T15:12:29.575Z", "is_approved": true}}, {"model": "recipes.comment", "pk": 4, "fields": {"recipe": 5, "author": "jk", "text": "kjkh", "created_at": "2026-06-25T13:42:44.502Z", "is_approved": true}}, {"model": "recipes.rating", "pk": 1, "fields": {"recipe": 4, "score": 5, "fingerprint": "fp_1781526929689_9vbkjsa1cri", "created_at": "2026-06-15T12:35:55.867Z"}}, {"model": "recipes.rating", "pk": 2, "fields": {"recipe": 5, "score": 5, "fingerprint": "fp_1781526929689_9vbkjsa1cri", "created_at": "2026-06-15T20:01:57.077Z"}}, {"model": "recipes.rating", "pk": 3, "fields": {"recipe": 8, "score": 5, "fingerprint": "fp_1781526929689_9vbkjsa1cri", "created_at": "2026-06-16T14:42:14.547Z"}}, {"model": "recipes.rating", "pk": 4, "fields": {"recipe": 7, "score": 5, "fingerprint": "fp_1781526929689_9vbkjsa1cri", "created_at": "2026-06-25T13:50:30.517Z"}}, {"model": "recipes.userpreferences", "pk": 1, "fields": {"fingerprint": "fp_1781526929689_9vbkjsa1cri", "timer_format": "mm:ss"}}]